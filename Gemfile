source "https://rubygems.org"

# GitHub Pages — pins Jekyll and all plugins to the exact versions
# GitHub's build servers run, so local previews match production.
gem "github-pages", group: :jekyll_plugins

# Webrick is no longer bundled with Ruby 3.0+, but jekyll serve needs it.
gem "webrick", "~> 1.8"

# Windows / JRuby helpers (harmless elsewhere)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
